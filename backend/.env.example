# Copy to .env and fill in. Never commit the filled-in version.

# ── Where this backend is reachable from the public internet ────────────
# Zoho and Vobiz both call back into this address. Use your deployed URL, or
# a tunnel (ngrok, cloudflared) for local work. No trailing slash.
PUBLIC_BASE_URL=https://your-backend.example.com
PORT=8092

# ── Secrets this backend needs (all required) ───────────────────────────
# Signs agent sessions, click-to-dial tokens, OAuth state and recording links.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=
# Encrypts stored Zoho tokens (AES-256-GCM). 32 bytes, hex or base64.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing it means every connected Zoho org must reconnect.
TOKEN_ENCRYPTION_KEY=
# Protects the admin routes (connect, register, status). Long and random.
ADMIN_TOKEN=

# Where connected orgs (zoho-orgs.json), provisioned endpoint ids
# (vobiz-endpoints.json — no passwords) and, by default, agents.json live.
# On a host, point this at a persistent disk so a restart keeps every org.
DATA_DIR=
# Optional explicit path for agents.json.
AGENTS_FILE=

# ── Vobiz ──────────────────────────────────────────────────────────────
# Nothing. Agents sign in to Vobiz from the softphone with their own Auth ID +
# Auth Token (or an existing endpoint's SIP login). No Vobiz Auth ID, token,
# SIP login or phone number belongs in this file.

# ── Zoho PhoneBridge OAuth client ───────────────────────────────────────
# The PhoneBridge client issued for your provider listing, with the
# PhoneBridge.call.log and PhoneBridge.zohoone.search scopes.
ZOHO_PB_CLIENT_ID=1000.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
ZOHO_PB_CLIENT_SECRET=
# Must match a redirect URI registered on that client, byte for byte, and must
# be served by THIS backend: <PUBLIC_BASE_URL>/oauth/zoho/callback (or
# /zoho/phonebridge/callback).
ZOHO_PB_REDIRECT_URI=https://your-backend.example.com/oauth/zoho/callback

# ── Optional ────────────────────────────────────────────────────────────
# Browser origins allowed to call this backend cross-origin (comma-separated).
# The bundled softphone is same-origin and needs none.
ALLOWED_ORIGINS=

# Refuse Vobiz webhooks whose X-Vobiz-Signature-V3 does not verify. Default is
# verify-and-warn. Turn on once the log shows "signature ok" on a real call.
REQUIRE_VOBIZ_SIGNATURE=

# Outbound calls are recorded unless this is false.
OUTBOUND_RECORD=
# Record inbound calls (off unless true).
INBOUND_RECORD=

# Send `missed` for unanswered calls (falls back to `ended`, 0s, if refused).
ZOHO_PB_SEND_MISSED_STATE=

# How long after a call ends to wait for its recording before logging the call
# without audio. Default 90000.
ZOHO_PB_RECORDING_GRACE_MS=
# Lifetime of the signed recording links given to Zoho. Default 30 days.
RECORDING_URL_TTL_DAYS=
# Optional separate key for recording links; derived from APP_SECRET if unset.
RECORDING_URL_SECRET=

# true enables POST /zoho/phonebridge/debug (admin only). Leave unset.
ZOHO_PB_DEBUG=
