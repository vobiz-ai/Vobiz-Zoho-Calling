# Copy to .env and fill in. Never commit the filled-in version.

# ── Where this backend is reachable from the public internet ────────────
# Both Zoho and VoBiz call back into this address, so localhost will not
# work for a real call — use the deployed URL, or a tunnel for local work.
PUBLIC_BASE_URL=https://your-backend.example.com
PORT=8092

# ── VoBiz account credentials ───────────────────────────────────────────
# REQUIRED for click-to-dial to work without a browser login.
#
# Agent sessions live only in memory, so every restart (redeploy, or an idle
# host spinning down) logs everyone out. Zoho's click-to-dial is
# server-to-server — there is no browser in the loop to prompt for a login —
# so without these the first call after any restart fails with a 409 and Zoho
# sees a broken provider. With them set, click-to-dial works from cold.
#
# A logged-in agent session still takes precedence when one exists.
VOBIZ_AUTH_ID=MA_XXXXXXXX
VOBIZ_AUTH_TOKEN=
# Caller ID used when falling back to account credentials.
VOBIZ_FROM_NUMBER=+91XXXXXXXXXX

# ── Zoho PhoneBridge partner credentials ────────────────────────────────
# From the password-protected PDF Zoho emailed on 4 Sep 2026
# ("Vobiz AI OAuth Details.pdf", password is in that email thread).
# These are NOT the ZOHO_TEST_* pair from the older Sigma/Deluge experiment —
# PhoneBridge scopes only work with the partner credentials.
ZOHO_PB_CLIENT_ID=1000.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
ZOHO_PB_CLIENT_SECRET=
ZOHO_PB_REDIRECT_URI=https://integrations.vobiz.ai/oauth/zoho/callback

# ── Keeping the Zoho connection across restarts ─────────────────────────
# The connected org is stored in zoho-orgs.json, which does NOT survive a
# restart on a host with an ephemeral filesystem (e.g. Render's free tier).
# Setting these two makes the connection durable — the backend rebuilds the
# org at boot. Both values are printed by /zoho/phonebridge/complete once you
# finish the OAuth flow.
ZOHO_PB_REFRESH_TOKEN=
ZOHO_PB_ORG_LOCATION=in

# Signs the time-limited recording URLs handed to Zoho as `voiceuri`.
# Any long random string. If unset, one is generated per boot — which means
# every previously-issued recording link breaks on restart.
RECORDING_URL_SECRET=

# How long to wait after a call ends for its recording webhook before logging
# the call to Zoho without audio. Default 90s.
ZOHO_PB_RECORDING_GRACE_MS=90000

# Zoho documents a `missed` callnotify state, but its live API answers 400 to
# it (and to busy/rejected/noanswer/notavailable) — see ISSUES.md #4. Calls
# nobody answered are therefore logged as `ended` with duration 0, which Zoho
# accepts. Set this to true only once Zoho starts taking the real state;
# until then it makes unanswered calls vanish from the Zoho record entirely.
ZOHO_PB_SEND_MISSED_STATE=

# Optional. When set, enables POST /zoho/phonebridge/debug for querying Zoho's
# PhoneBridge API directly. Leave unset in normal operation.
ZOHO_PB_DEBUG_SECRET=

# ── Strict mode for VoBiz webhook signatures ────────────────────────────
# Default (unset) verifies and warns. Set to true to refuse calls whose
# signature does not verify — only once the signing scheme is confirmed
# against real VoBiz traffic, or every call will be dropped.
REQUIRE_VOBIZ_SIGNATURE=
